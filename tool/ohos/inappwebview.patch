diff --git a/test/venera_interface_compat_test.dart b/test/venera_interface_compat_test.dart
new file mode 100644
index 0000000..899590c
--- /dev/null
+++ b/test/venera_interface_compat_test.dart
@@ -0,0 +1,87 @@
+import 'dart:convert';
+
+import 'package:flutter/services.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:flutter_inappwebview_platform_interface/flutter_inappwebview_platform_interface.dart';
+
+import '../lib/src/in_app_webview/in_app_webview_controller.dart';
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+
+  late OhosInAppWebViewController controller;
+  setUp(() {
+    controller = OhosInAppWebViewController(
+      const PlatformInAppWebViewControllerCreationParams(id: 'compat-test'),
+    );
+  });
+
+  test('legacy callbacks receive decoded arguments and return JSON', () async {
+    controller.addJavaScriptHandler(
+      handlerName: 'legacy',
+      callback: (List<dynamic> args) => {'result': args.single},
+    );
+    final result = await controller.handleMethod(const MethodCall(
+      'onCallJsHandler',
+      {'handlerName': 'legacy', 'args': '["value"]'},
+    ));
+    expect(jsonDecode(result), {'result': 'value'});
+  });
+
+  test('parameterless callbacks remain callable and removable', () async {
+    final callback = () => 7;
+    controller.addJavaScriptHandler(handlerName: 'plain', callback: callback);
+    final result = await controller.handleMethod(const MethodCall(
+      'onCallJsHandler',
+      {'handlerName': 'plain', 'args': '[]'},
+    ));
+    expect(jsonDecode(result), 7);
+    expect(controller.removeJavaScriptHandler(handlerName: 'plain'), callback);
+    expect(controller.hasJavaScriptHandler(handlerName: 'plain'), isFalse);
+  });
+
+  test('typed callbacks reject absent native caller metadata', () async {
+    var invoked = false;
+    controller.addJavaScriptHandler(
+      handlerName: 'typed',
+      callback: (JavaScriptHandlerFunctionData data) {
+        invoked = true;
+      },
+    );
+    await expectLater(
+      controller.handleMethod(const MethodCall(
+        'onCallJsHandler',
+        {'handlerName': 'typed', 'args': '[]'},
+      )),
+      throwsA(isA<Exception>()),
+    );
+    expect(invoked, isFalse);
+  });
+
+  test('typed callbacks preserve native origin, frame and request URL', () async {
+    JavaScriptHandlerFunctionData? received;
+    controller.addJavaScriptHandler(
+      handlerName: 'typed',
+      callback: (JavaScriptHandlerFunctionData data) {
+        received = data;
+        return data.args.single;
+      },
+    );
+    final result = await controller.handleMethod(const MethodCall(
+      'onCallJsHandler',
+      {
+        'handlerName': 'typed',
+        'data': {
+          'args': '[9]',
+          'origin': 'https://frame.example',
+          'requestUrl': 'https://frame.example/embedded',
+          'isMainFrame': false,
+        },
+      },
+    ));
+    expect(jsonDecode(result), 9);
+    expect(received!.origin.toString(), 'https://frame.example');
+    expect(received!.requestUrl.toString(), 'https://frame.example/embedded');
+    expect(received!.isMainFrame, isFalse);
+  });
+}
