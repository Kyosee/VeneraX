<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/reading_widget_background"
    android:orientation="vertical"
    android:padding="12dp">
    <include layout="@layout/reading_widget_header" />
    <TextView
        android:id="@+id/reading_widget_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/reading_widget_secondary"
        android:textSize="10sp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/reading_widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="8dp"
        android:text="@string/reading_widget_open"
        android:textColor="@color/reading_widget_secondary"
        android:textSize="13sp"
        android:visibility="gone" />
    <LinearLayout
        android:id="@+id/reading_widget_items"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">
        <include layout="@layout/reading_widget_row" />
        <include layout="@layout/reading_widget_row" />
    </LinearLayout>
</LinearLayout>
