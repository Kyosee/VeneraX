<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/reading_widget_item"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:layout_weight="1"
    android:background="@drawable/reading_widget_item_background"
    android:orientation="vertical">
    <FrameLayout
        android:id="@+id/reading_widget_cover_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal">
        <ImageView
            android:id="@+id/reading_widget_image"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:background="@drawable/reading_widget_cover_background"
            android:clipToOutline="true"
            android:importantForAccessibility="no"
            android:maxHeight="160dp"
            android:scaleType="fitCenter"
            android:src="@drawable/reading_widget_placeholder" />
        <TextView
            android:id="@+id/reading_widget_item_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="4dp"
            android:background="@drawable/reading_widget_badge_background"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:maxWidth="76dp"
            android:paddingStart="5dp"
            android:paddingTop="3dp"
            android:paddingEnd="5dp"
            android:paddingBottom="3dp"
            android:textColor="@color/reading_widget_on_accent"
            android:textSize="9sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>
    <TextView
        android:id="@+id/reading_widget_item_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:text="@string/reading_widget_continue"
        android:textColor="@color/reading_widget_primary"
        android:textSize="12sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/reading_widget_item_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/reading_widget_secondary"
        android:textSize="10sp" />
    <TextView
        android:id="@+id/reading_widget_item_source"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/reading_widget_secondary"
        android:textSize="10sp"
        android:visibility="gone" />
    <ProgressBar
        android:id="@+id/reading_widget_item_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="5dp"
        android:importantForAccessibility="no"
        android:indeterminate="false"
        android:max="100"
        android:progressBackgroundTint="@color/reading_widget_track"
        android:progressDrawable="@drawable/reading_widget_progress"
        android:progressTint="@color/reading_widget_accent"
        android:visibility="gone" />
</LinearLayout>
